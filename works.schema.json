{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Works catalog",
  "description": "Works Portal のカタログデータ (portal/works.json) のスキーマ",
  "type": "object",
  "additionalProperties": false,
  "required": ["works"],
  "properties": {
    "works": {
      "type": "array",
      "items": { "$ref": "#/definitions/work" }
    }
  },
  "definitions": {
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "category", "status", "date"],
      "properties": {
        "id": {
          "type": "string",
          "description": "作品の一意なID。サブドメインにも使う想定",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "emoji": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "url": { "type": "string" },
        "repo": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["published", "wip", "planned"]
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
