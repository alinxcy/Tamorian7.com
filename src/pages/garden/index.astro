---
import Base from '../../layouts/Base.astro';
import { getGarden, fmtDate } from '../../lib/util';
import { u } from '../../lib/url';

const notes = await getGarden();
---
<Base title="Garden">
  <section class="section" style="margin-top:32px">
    <h1 style="margin:0 0 4px">Garden</h1>
    <p class="lead">主題ごとに育てる知見。プロジェクトをまたいで再利用されるもの。更新の新しい順。</p>
  </section>
  <ul class="note-list">
    {notes.map((note) => (
      <li>
        <div class="row">
          <a class="title" href={u(`/garden/${note.id}/`)}>{note.data.title}</a>
          <span class="date">updated {fmtDate(note.data.updated)}</span>
        </div>
        {note.data.summary && <p class="summary">{note.data.summary}</p>}
        <div class="tags" style="margin-top:6px">
          {note.data.tags.map((t) => <a class="tag" href={u(`/tags/${t}/`)}>{t}</a>)}
        </div>
      </li>
    ))}
  </ul>
</Base>
