---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate, getGarden, getWorks, getBacklinks, getRelated, KIND_LABEL } from '../../lib/util';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const notes = await getGarden(); // 公開分のみ(publish:false は除外)
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, tags, updated, created, project } = note.data;

// 所属プロジェクト(あれば)
const parent = project ? (await getWorks()).find((w) => w.id === project) : undefined;

const backlinks = await getBacklinks(note.id);
const related = await getRelated(note.id, tags, backlinks.filter((b) => b.kind === 'garden').map((b) => b.id));
---
<Base title={title} description={note.data.summary}>
  <div class="with-toc">
    <article class="article">
      <h1 class="title">{title}</h1>
      <div class="meta">
        <span>updated {fmtDate(updated)}</span>
        {created && <span>· created {fmtDate(created)}</span>}
        {parent && (
          <span>· <a href={u(`/works/${parent.id}/`)}>{parent.data.emoji ?? ''} {parent.data.title}</a></span>
        )}
      </div>
      <div class="tags" style="margin-bottom:20px">
        {tags.map((t) => <a class="tag" href={u(`/tags/${t}/`)}>{t}</a>)}
      </div>
      <div class="article-body" data-pagefind-body>
        <Content />
      </div>

      {(backlinks.length > 0 || related.length > 0) && (
        <section class="connections">
          {backlinks.length > 0 && (
            <div class="conn-block">
              <h4>このノートを参照</h4>
              <ul>
                {backlinks.map((b) => (
                  <li><a href={u(`/${b.kind}/${b.id}/`)}>{b.title}</a>
                    <span class="muted"> · {KIND_LABEL[b.kind]}</span></li>
                ))}
              </ul>
            </div>
          )}
          {related.length > 0 && (
            <div class="conn-block">
              <h4>関連ノート(タグ共有)</h4>
              <ul>
                {related.map((r) => (
                  <li><a href={u(`/garden/${r.id}/`)}>{r.title}</a></li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}
    </article>

    {toc.length > 0 && (
      <nav class="toc" aria-label="目次">
        <h4>目次</h4>
        <ul>
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'h3' : 'h2'}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</Base>
