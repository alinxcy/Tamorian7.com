---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';

// 全文検索は Pagefind(クライアント側・バックエンド不要)。
// /pagefind/ 配下はビルド後に生成されるため、検索が効くのは
// `npm run build` + `npm run preview`(または本番)時。`astro dev` では未生成。
// base(サブパス配信)対応のため、アセット/バンドル/結果URLに base を前置する。
const base = import.meta.env.BASE_URL; // 末尾スラッシュ付き
const bundlePath = base.replace(/\/+$/, '') + '/pagefind/';
const uiJs = u('/pagefind/pagefind-ui.js');
const uiCss = u('/pagefind/pagefind-ui.css');
---
<Base title="検索">
  <section class="section" style="margin-top:32px">
    <h1 style="margin:0 0 4px">検索</h1>
    <p class="lead">常緑ノート・ログを全文検索。</p>
  </section>
  <div class="search-box">
    <div id="search"></div>
    <p class="muted" id="search-note" style="margin-top:12px; font-size:0.85rem">
      検索インデックスはビルド時に生成されます(<code>npm run build</code> 後の
      <code>npm run preview</code> / 本番で有効)。
    </p>
  </div>

  <link rel="stylesheet" href={uiCss} />
  <script is:inline src={uiJs}></script>
  <script is:inline define:vars={{ bundlePath, base }}>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') return;
      const b = base.replace(/\/+$/, '');
      const ui = new PagefindUI({
        element: '#search',
        bundlePath,
        showSubResults: true,
        showImages: false,
        // インデックスは dist ルート基準のURL(/garden/...)を持つため base を前置
        processResult: (result) => {
          if (result && typeof result.url === 'string' && result.url.startsWith('/') && !result.url.startsWith(b + '/')) {
            result.url = b + result.url;
          }
          return result;
        },
      });
      const note = document.getElementById('search-note');
      if (note) note.remove();

      // **?q= で検索を URL にする。** 検索結果を他所からリンクできないと、
      // 「探せば出る」と書いても辿り着けない(2026-08-27)
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    });
  </script>
</Base>
