---
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
import { SITE } from '../site.config';
import { getGarden, getLog, getTagCounts, fmtDate } from '../lib/util';
import { u } from '../lib/url';

const garden = await getGarden();
const log = await getLog();
const tagCounts = [...(await getTagCounts()).entries()].sort((a, b) => b[1] - a[1]);

const growing = garden.slice(0, 6);        // 育成中(最近更新)の常緑ノート
const latestLog = log.slice(0, 5);         // 最新ログ
---
<Base>
  <section class="section" style="margin-top:32px">
    <h1 style="margin:0 0 4px; font-size:1.9rem">{SITE.name}</h1>
    <p class="lead">{SITE.tagline}</p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>タグで探す</h2>
      <a class="muted" href={u('/tags/')}>すべてのタグ →</a>
    </div>
    <div class="tags">
      {tagCounts.map(([tag, n]) => (
        <a class="tag" href={u(`/tags/${tag}/`)}>{tag}<span class="n">{n}</span></a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>育成中の常緑ノート</h2>
      <a class="muted" href={u('/garden/')}>常緑ノート一覧 →</a>
    </div>
    <div class="cards">
      {growing.map((note) => <NoteCard note={note} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最新のログ</h2>
      <a class="muted" href={u('/log/')}>ログ一覧 →</a>
    </div>
    <ul class="note-list">
      {latestLog.map((l) => (
        <li>
          <div class="row">
            <a class="title" href={u(`/log/${l.id}/`)}>{l.data.title}</a>
            <span class="date">{fmtDate(l.data.date)}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
