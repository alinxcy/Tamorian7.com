---
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
import { SITE } from '../site.config';
import { getGarden, getLog, getWorks, getTagCounts, fmtDate } from '../lib/util';
import { u } from '../lib/url';

const garden = await getGarden();
const log = await getLog();
const works = await getWorks();
const tagCounts = [...(await getTagCounts()).entries()].sort((a, b) => b[1] - a[1]);

const active = works.filter((w) => w.data.status !== 'published').slice(0, 6); // 作業中
const growing = garden.slice(0, 6);
const latestLog = log.slice(0, 5);
---
<Base>
  <section class="section" style="margin-top:32px">
    <h1 style="margin:0 0 4px; font-size:1.9rem">{SITE.name}</h1>
    <p class="lead">{SITE.tagline}</p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>タグで探す</h2>
      <a class="muted" href={u('/tags/')}>すべてのタグ →</a>
    </div>
    <div class="tags">
      {tagCounts.map(([tag, n]) => (
        <a class="tag" href={u(`/tags/${tag}/`)}>{tag}<span class="n">{n}</span></a>
      ))}
    </div>
  </section>

  {active.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>いま作っているもの</h2>
        <a class="muted" href={u('/works/')}>Works 一覧 →</a>
      </div>
      <div class="cards">
        {active.map((w) => (
          <NoteCard
            href={u(`/works/${w.id}/`)}
            title={w.data.title}
            emoji={w.data.emoji}
            summary={w.data.summary}
            tags={w.data.tags}
            status={w.data.status}
          />
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>育てているノート</h2>
      <a class="muted" href={u('/garden/')}>Garden 一覧 →</a>
    </div>
    <div class="cards">
      {growing.map((note) => (
        <NoteCard
          href={u(`/garden/${note.id}/`)}
          title={note.data.title}
          summary={note.data.summary}
          tags={note.data.tags}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最新のログ</h2>
      <a class="muted" href={u('/log/')}>Log 一覧 →</a>
    </div>
    <ul class="note-list">
      {latestLog.map((l) => (
        <li>
          <div class="row">
            <a class="title" href={u(`/log/${l.id}/`)}>{l.data.title}</a>
            <span class="date">{fmtDate(l.data.date)}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
