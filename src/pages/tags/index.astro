---
import Base from '../../layouts/Base.astro';
import { getTagCounts } from '../../lib/util';
import { u } from '../../lib/url';

const tags = [...(await getTagCounts()).entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Tags">
  <section class="section" style="margin-top:32px">
    <h1 style="margin:0 0 4px">Tags</h1>
    <p class="lead">Garden / Log / Works を横断。件数の多い順。</p>
  </section>
  <div class="tags">
    {tags.map(([tag, n]) => (
      <a class="tag" href={u(`/tags/${tag}/`)}>{tag}<span class="n">{n}</span></a>
    ))}
  </div>
</Base>
