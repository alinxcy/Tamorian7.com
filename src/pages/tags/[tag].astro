---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../lib/util';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const garden = await getCollection('garden', (e) => e.data.publish !== false);
  const log = await getCollection('log', (e) => e.data.publish !== false);
  const tags = new Set<string>();
  for (const e of [...garden, ...log]) for (const t of e.data.tags ?? []) tags.add(t);

  return [...tags].map((tag) => {
    const gardenHits = garden
      .filter((n) => n.data.tags.includes(tag))
      .map((n) => ({ kind: 'garden' as const, id: n.id, title: n.data.title, date: n.data.updated, emoji: n.data.emoji }));
    const logHits = log
      .filter((l) => l.data.tags.includes(tag))
      .map((l) => ({ kind: 'log' as const, id: l.id, title: l.data.title, date: l.data.date, emoji: undefined }));
    const items = [...gardenHits, ...logHits].sort((a, b) => b.date.getTime() - a.date.getTime());
    return { params: { tag }, props: { tag, items } };
  });
}

const { tag, items } = Astro.props;
---
<Base title={`#${tag}`}>
  <section class="section" style="margin-top:32px">
    <h1 style="margin:0 0 4px">#{tag}</h1>
    <p class="lead">{items.length} 件</p>
  </section>
  <ul class="note-list">
    {items.map((it) => (
      <li>
        <div class="row">
          <a class="title" href={u(`/${it.kind}/${it.id}/`)}>
            {it.emoji ? `${it.emoji} ` : ''}{it.title}
            <span class="muted" style="font-weight:400; font-size:0.8rem"> · {it.kind === 'garden' ? '常緑' : 'ログ'}</span>
          </a>
          <span class="date">{fmtDate(it.date)}</span>
        </div>
      </li>
    ))}
  </ul>
</Base>
