---
import Base from '../../layouts/Base.astro';
import { fmtDate, getGarden, getLog, getSeeds, getWorks, KIND_LABEL } from '../../lib/util';
import { u } from '../../lib/url';

// タグページは Garden / Log / Seeds / Works を混ぜて出す。
// 「この話題で自分は何を持っているか」が一望できることが、このサイトの核。
export async function getStaticPaths() {
  const [garden, log, seeds, works] = [await getGarden(), await getLog(), await getSeeds(), await getWorks()];
  const tags = new Set<string>();
  for (const e of [...garden, ...log, ...seeds, ...works]) for (const t of e.data.tags ?? []) tags.add(t);

  return [...tags].map((tag) => {
    const items = [
      ...garden
        .filter((n) => n.data.tags.includes(tag))
        .map((n) => ({ kind: 'garden' as const, id: n.id, title: n.data.title, date: n.data.updated, emoji: undefined as string | undefined })),
      ...log
        .filter((l) => l.data.tags.includes(tag))
        .map((l) => ({ kind: 'log' as const, id: l.id, title: l.data.title, date: l.data.date, emoji: undefined as string | undefined })),
      ...seeds
        .filter((s) => s.data.tags.includes(tag))
        .map((s) => ({ kind: 'seeds' as const, id: s.id, title: s.data.title, date: s.data.found, emoji: undefined as string | undefined })),
      ...works
        .filter((w) => w.data.tags.includes(tag))
        .map((w) => ({ kind: 'works' as const, id: w.id, title: w.data.title, date: w.data.updated, emoji: w.data.emoji })),
    ].sort((a, b) => b.date.getTime() - a.date.getTime());
    return { params: { tag }, props: { tag, items } };
  });
}

const { tag, items } = Astro.props;
---
<Base title={`#${tag}`}>
  <section class="section" style="margin-top:32px">
    <h1 style="margin:0 0 4px">#{tag}</h1>
    <p class="lead">{items.length} 件</p>
  </section>
  <ul class="note-list">
    {items.map((it) => (
      <li>
        <div class="row">
          <a class="title" href={u(`/${it.kind}/${it.id}/`)}>
            {it.emoji ? `${it.emoji} ` : ''}{it.title}
            <span class="muted" style="font-weight:400; font-size:0.8rem"> · {KIND_LABEL[it.kind]}</span>
          </a>
          <span class="date">{fmtDate(it.date)}</span>
        </div>
      </li>
    ))}
  </ul>
</Base>
