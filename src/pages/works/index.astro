---
import Base from '../../layouts/Base.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getWorks } from '../../lib/util';
import { u } from '../../lib/url';

const works = await getWorks();
---
<Base title="Works">
  <section class="section" style="margin-top:32px">
    <h1 style="margin:0 0 4px">Works</h1>
    <p class="lead">
      プロジェクト単位。制作中は<strong>作業場</strong>、完成したら<strong>使い方</strong>に入れ替わる。
    </p>
  </section>
  <div class="cards">
    {works.map((w) => (
      <NoteCard
        href={u(`/works/${w.id}/`)}
        title={w.data.title}
        emoji={w.data.emoji}
        summary={w.data.summary}
        tags={w.data.tags}
        status={w.data.status}
      />
    ))}
  </div>
  {works.length === 0 && <p class="muted">まだ Works がありません。</p>}
</Base>
