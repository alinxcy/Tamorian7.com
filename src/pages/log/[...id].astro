---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate, fmtDateTime, getLog, getWorks } from '../../lib/util';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const logs = await getLog(); // 公開分のみ(publish:false は除外)
  return logs.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, until, tags, project } = entry.data;

// **いつやったかを出す。** 一晩をまたぐ回だと、本文の「朝になって分かった」
// のような記述が、時刻なしでは読めない
const sameDay = until && fmtDate(until) === fmtDate(date);
const when = until
  ? `${fmtDateTime(date)} 〜 ${sameDay ? fmtDateTime(until).slice(11) : fmtDateTime(until)}`
  : fmtDateTime(date);
const parent = project ? (await getWorks()).find((w) => w.id === project) : undefined;
---
<Base title={title}>
  <article class="article">
    <h1 class="title">{title}</h1>
    <div class="meta">
      <span>{when}</span>
      {parent && (
        <span>· <a href={u(`/works/${parent.id}/`)}>{parent.data.emoji ?? ''} {parent.data.title}</a></span>
      )}
      <div class="tags">
        {tags.map((t) => <a class="tag" href={u(`/tags/${t}/`)}>{t}</a>)}
      </div>
    </div>
    <div class="article-body" data-pagefind-body>
      <Content />
    </div>
  </article>
</Base>
