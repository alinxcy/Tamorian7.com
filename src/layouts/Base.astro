---
import '../styles/global.css';
import { SITE } from '../site.config';
import { u } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌱</text></svg>" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={u('/')}>🌱 {SITE.name}</a>
        <!--
          **6本に固定する。** 上が動くと毎回置き場所が変わって覚えられなくなる
          （2026-07-31 の設計より）。Tags と State はトップの下段から飛べる。
        -->
        <nav class="site-nav">
          <a href={u('/garden/')}>Garden</a>
          <a href={u('/log/')}>Log</a>
          <a href={u('/works/')}>Works</a>
          <a href={u('/seeds/')}>Seeds</a>
          <a href={u('/toolbox/')}>Toolbox</a>
          <a href={u('/search/')}>Search</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} {SITE.author} · {SITE.name}</div>
    </footer>
  </body>
</html>
