---
import { u } from '../lib/url';
import { STATUS_LABEL } from '../lib/util';

// コレクション非依存のカード。Garden ノートにも Works にも使う。
interface Props {
  href: string;
  title: string;
  emoji?: string;
  summary?: string;
  tags?: string[];
  status?: string;
}
const { href, title, emoji, summary, tags = [], status } = Astro.props;
---
<article class="card">
  <div class="card-head">
    {emoji && <span class="emoji">{emoji}</span>}
    <h3 class="card-title"><a href={href}>{title}</a></h3>
    {status && <span class={`badge ${status}`}>{STATUS_LABEL[status] ?? status}</span>}
  </div>
  {summary && <p class="card-desc">{summary}</p>}
  <div class="card-meta">
    <div class="tags">
      {tags.map((t) => <a class="tag" href={u(`/tags/${t}/`)}>{t}</a>)}
    </div>
  </div>
</article>
